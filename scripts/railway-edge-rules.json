{
  "version": 1,
  "rules": [
    {
      "description": "Block bulk AI and backlink crawlers",
      "priority": 10,
      "enabled": true,
      "if": {
        "or": [
          { "attr": "http.header", "key": "user-agent", "op": "contains", "value": "GPTBot" },
          { "attr": "http.header", "key": "user-agent", "op": "contains", "value": "PerplexityBot" },
          { "attr": "http.header", "key": "user-agent", "op": "contains", "value": "meta-externalagent" },
          { "attr": "http.header", "key": "user-agent", "op": "contains", "value": "Amazonbot" },
          { "attr": "http.header", "key": "user-agent", "op": "contains", "value": "SERankingBacklinksBot" },
          { "attr": "http.header", "key": "user-agent", "op": "contains", "value": "Reflectionbot" },
          { "attr": "http.header", "key": "user-agent", "op": "contains", "value": "ClaudeBot" },
          { "attr": "http.header", "key": "user-agent", "op": "contains", "value": "Bytespider" },
          { "attr": "http.header", "key": "user-agent", "op": "contains", "value": "CCBot" }
        ]
      },
      "then": { "action": "block", "params": { "status": 403, "body": "Crawling disabled." } }
    }
  ]
}
