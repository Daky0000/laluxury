{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "npm run build"
  },
  "deploy": {
    "preDeployCommand": "npm run db:migrate && node scripts/seed-once.mjs && node scripts/migrate-images-to-r2.mjs",
    "preDeployTimeoutSeconds": 300,
    "startCommand": "node --max-old-space-size=384 ./node_modules/next/dist/bin/next start",
    "healthcheckPath": "/api/health",
    "healthcheckTimeout": 120,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 5
  }
}
