# ---------------------------------------------------------------------------
# LaLuxury — environment
# Copy to `.env` and fill in. Only DATABASE_URL and AUTH_SECRET are required
# to boot. Production media uploads require R2; app releases require APK_DOWNLOAD_URL.
# ---------------------------------------------------------------------------

# --- Core (required) -------------------------------------------------------
# Railway injects this automatically when you attach a Postgres service.
DATABASE_URL="postgresql://user:password@localhost:5432/laluxurys"

# Signs session cookies. Generate with: openssl rand -base64 32
AUTH_SECRET=""

# Public origin, no trailing slash. Used for Paystack callbacks and emails.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"


# --- Paystack (payments, GHS) ----------------------------------------------
# Dashboard > Settings > API Keys & Webhooks
PAYSTACK_SECRET_KEY=""
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=""
# Paystack callback: {NEXT_PUBLIC_SITE_URL}/checkout/confirm
# Paystack webhook:  {NEXT_PUBLIC_SITE_URL}/api/webhooks/paystack
# Both URLs must use your public HTTPS domain, never localhost.
NEXT_PUBLIC_CURRENCY="GHS"
# A separate test pair, so switching to "test" never overwrites the live keys.
PAYSTACK_MODE="live"
PAYSTACK_TEST_SECRET_KEY=""
PAYSTACK_TEST_PUBLIC_KEY=""


# --- AI operations agent -----------------------------------------------------
# One key switches the agent on: either a Claude key (used directly) or an
# OpenRouter key. Everything here can also be pasted into the console under
# Settings > Integrations, which wins over the environment.
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-opus-5"
OPENROUTER_API_KEY=""
# Model slug. Override if the alpha slug changes.
OPENROUTER_MODEL="openrouter/ox-alpha"
# Optional fallback used when the primary model is unavailable.
OPENROUTER_FALLBACK_MODEL="anthropic/claude-sonnet-4.5"


# --- Slack (agent channel) -------------------------------------------------
# api.slack.com/apps > your app. Needs scopes:
#   app_mentions:read, chat:write, im:history, im:read, im:write, users:read
SLACK_BOT_TOKEN=""
SLACK_SIGNING_SECRET=""
# Channel the agent posts alerts to (low stock, new orders). e.g. C0123ABCD
SLACK_ALERT_CHANNEL=""
# Event subscription URL: {NEXT_PUBLIC_SITE_URL}/api/webhooks/slack


# --- WhatsApp Cloud API (agent channel) ------------------------------------
# developers.facebook.com > your app > WhatsApp
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
# Any string you choose; paste the same value into the Meta webhook config.
WHATSAPP_VERIFY_TOKEN=""
# App secret, used to verify the X-Hub-Signature-256 header.
WHATSAPP_APP_SECRET=""
# Callback URL: {NEXT_PUBLIC_SITE_URL}/api/webhooks/whatsapp


# --- Email (transactional) -------------------------------------------------
# Order notices are texted first and emailed as well when this is set. It is
# also what carries password-reset links for staff accounts keyed on email.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
EMAIL_FROM="Noble Enclave <orders@nobleenclave.com>"


# --- Database pool ---------------------------------------------------------
# How many Postgres connections one instance of the app may hold. Left unset it
# is 3, which is ample here. Raise it only after checking the database's own
# max_connections against the number of instances running — exceeding it is how
# you get "max number of clients reached".
DATABASE_POOL_MAX="3"


# --- SMS and one-time codes (Vynfy) ----------------------------------------
# Registration is by phone number, and the code that verifies it is sent from
# here. Without a key nobody can create a customer account.
# Docs: https://www.vynfy.com/api-documentation
VYNFY_API_KEY=""
# The brand name shown as the sender on the handset. Max 11 characters, and it
# has to be registered with Vynfy before it will deliver.
VYNFY_SENDER_ID="LaLuxury"


# --- Image storage (Cloudflare R2 - $0 Egress or Cloudinary) ---------------
# Production uploads require R2. Only development may fall back to Cloudinary or Postgres.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="laluxurys-media"
R2_PUBLIC_URL=""
# Set these only after verifying every catalog object on the custom domain.
CATALOG_CDN_URL=""
NEXT_PUBLIC_MEDIA_BASE_URL=""
# Required for releases: HTTPS versioned APK object; prefer a custom media domain.
APK_DOWNLOAD_URL=""
# Bulk AI/backlink crawlers are rejected before expensive public rendering.
BULK_CRAWLER_BLOCK_ENABLED="true"

CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""


# --- Seed (first admin account) --------------------------------------------
SEED_OWNER_EMAIL="owner@nobleenclave.com"
SEED_OWNER_PASSWORD="ChangeMe!2026"

# --- Bulk Product Add (OpenRouter, server-side only) -------------------------
# Uses the OpenRouter key above unless a dedicated one is set here.
# BULK_AI_OPENROUTER_API_KEY=""
BULK_AI_ENABLED=true
BULK_AI_POLICY=FREE_ONLY
BULK_AI_FAST_MODEL_1=nvidia/nemotron-3.5-lightning:free
BULK_AI_FAST_MODEL_2=nvidia/nemotron-3-super-120b-a12b:free
BULK_AI_FAST_MODEL_3=nvidia/nemotron-3-ultra-550b-a55b:free
BULK_AI_COMPLEX_MODEL_1=nvidia/nemotron-3-super-120b-a12b:free
BULK_AI_COMPLEX_MODEL_2=nvidia/nemotron-3-ultra-550b-a55b:free
BULK_AI_COMPLEX_MODEL_3=nvidia/nemotron-3.5-lightning:free
BULK_AI_VISION_MODEL_1=inclusionai/ling-3.0-flash-vl:free
BULK_AI_VISION_MODEL_2=thinkingmachines/inkling:free
BULK_AI_VISION_MODEL_3=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free
