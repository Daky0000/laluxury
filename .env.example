# ---------------------------------------------------------------------------
# LaLuxury — environment
# Copy to `.env` and fill in. Only DATABASE_URL and AUTH_SECRET are required
# to boot; every integration below degrades gracefully when left blank.
# ---------------------------------------------------------------------------

# --- Core (required) -------------------------------------------------------
# Railway injects this automatically when you attach a Postgres service.
DATABASE_URL="postgresql://user:password@localhost:5432/laluxurys"

# Signs session cookies. Generate with: openssl rand -base64 32
AUTH_SECRET=""

# Public origin, no trailing slash. Used for Paystack callbacks and emails.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"


# --- Paystack (payments, GHS) ----------------------------------------------
# Dashboard > Settings > API Keys & Webhooks
PAYSTACK_SECRET_KEY=""
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=""
# Point Paystack's webhook at: {NEXT_PUBLIC_SITE_URL}/api/webhooks/paystack
NEXT_PUBLIC_CURRENCY="GHS"


# --- AI operations agent (OpenRouter) --------------------------------------
# The only key required to switch the agent on.
OPENROUTER_API_KEY=""
# Model slug. Override if the alpha slug changes.
OPENROUTER_MODEL="openrouter/ox-alpha"
# Optional fallback used when the primary model is unavailable.
OPENROUTER_FALLBACK_MODEL="anthropic/claude-sonnet-4.5"


# --- Slack (agent channel) -------------------------------------------------
# api.slack.com/apps > your app. Needs scopes:
#   app_mentions:read, chat:write, im:history, im:read, im:write, users:read
SLACK_BOT_TOKEN=""
SLACK_SIGNING_SECRET=""
# Channel the agent posts alerts to (low stock, new orders). e.g. C0123ABCD
SLACK_ALERT_CHANNEL=""
# Event subscription URL: {NEXT_PUBLIC_SITE_URL}/api/webhooks/slack


# --- WhatsApp Cloud API (agent channel) ------------------------------------
# developers.facebook.com > your app > WhatsApp
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
# Any string you choose; paste the same value into the Meta webhook config.
WHATSAPP_VERIFY_TOKEN=""
# App secret, used to verify the X-Hub-Signature-256 header.
WHATSAPP_APP_SECRET=""
# Callback URL: {NEXT_PUBLIC_SITE_URL}/api/webhooks/whatsapp


# --- Email (transactional) -------------------------------------------------
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
EMAIL_FROM="LaLuxury <orders@laluxury.com>"


# --- Image storage ---------------------------------------------------------
# Leave blank to store uploads on local disk at /public/uploads
# (attach a Railway volume mounted there so they survive redeploys).
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""


# --- Seed (first admin account) --------------------------------------------
SEED_OWNER_EMAIL="owner@laluxury.com"
SEED_OWNER_PASSWORD="ChangeMe!2026"
