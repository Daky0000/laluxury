{
  "expo": {
    "name": "Noble Enclave",
    "slug": "danny",
    "owner": "danny1999s-team",
    "version": "1.3.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.nobleenclave.management"
    },
    "android": {
      "package": "com.nobleenclave.management",
      "versionCode": 13,
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "backgroundColor": "#7A2E3C",
        "foregroundImage": "./assets/icon.png"
      }
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Noble Enclave to access your photos to attach product imagery.",
          "cameraPermission": "Allow Noble Enclave to capture inventory photos directly with camera."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/splash-icon.png",
          "color": "#7A2E3C"
        }
      ],
      "expo-secure-store",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "backgroundColor": "#7A2E3C",
          "imageWidth": 220
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "9acc53b0-c45d-4274-88bf-65ff2dfde707"
      }
    }
  }
}
