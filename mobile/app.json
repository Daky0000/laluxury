{
  "expo": {
    "name": "Noble Enclave",
    "slug": "danny",
    "owner": "danny1999s-team",
    "version": "1.4.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.nobleenclave.management",
      "associatedDomains": [
        "applinks:nobleenclave.com"
      ],
      "infoPlist": {
        "NSFaceIDUsageDescription": "Use Face ID to unlock the Noble Enclave store backend."
      }
    },
    "android": {
      "package": "com.laluxury.management",
      "versionCode": 18,
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "backgroundColor": "#7A2E3C",
        "foregroundImage": "./assets/android-icon-foreground.png"
      },
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "nobleenclave.com",
              "pathPrefix": "/product"
            },
            {
              "scheme": "https",
              "host": "www.nobleenclave.com",
              "pathPrefix": "/product"
            },
            {
              "scheme": "https",
              "host": "nobleenclave.com",
              "pathPrefix": "/orders/track"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Noble Enclave to access your photos to attach product imagery.",
          "cameraPermission": "Allow Noble Enclave to capture inventory photos directly with camera."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/splash-icon.png",
          "color": "#7A2E3C"
        }
      ],
      "expo-secure-store",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "backgroundColor": "#7A2E3C",
          "imageWidth": 220
        }
      ],
      "expo-image",
      "expo-updates",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Use Face ID to unlock the Noble Enclave store backend."
        }
      ],
      "@sentry/react-native"
    ],
    "extra": {
      "eas": {
        "projectId": "9acc53b0-c45d-4274-88bf-65ff2dfde707"
      }
    },
    "scheme": "nobleenclave",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/9acc53b0-c45d-4274-88bf-65ff2dfde707",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    }
  }
}
